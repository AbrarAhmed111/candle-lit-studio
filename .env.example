# Copy to .env.local and fill in. Leave the Supabase keys empty to run on demo data.

# Supabase: Project Settings > API Keys. Use the publishable key
# (or set NEXT_PUBLIC_SUPABASE_ANON_KEY to the legacy anon key instead).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the store, used for sign-in return links and share previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
