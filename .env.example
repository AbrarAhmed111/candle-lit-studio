# Copy to .env.local and fill in. Leave the Supabase keys empty to run on demo data.

# Supabase: Project Settings > API Keys. Use the publishable key
# (or set NEXT_PUBLIC_SUPABASE_ANON_KEY to the legacy anon key instead).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the store, used for sign-in return links and share previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Supabase: Project Settings > API Keys > service_role (or secret key).
# Used to send emails from checkout, the daily review job and unsubscribe links.
SUPABASE_SERVICE_ROLE_KEY=

# Email (nodemailer, any SMTP provider). Gmail: smtp.gmail.com, port 465, and an
# app password from https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Defaults to SMTP_USER.
SMTP_FROM="Candle Lit Studio <hello@candlelitstudio.pk>"

# Any long random string. Vercel sends it to the daily review-request job.
CRON_SECRET=
